# ==============================================================================
# AuthGuard-X Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the application:
#   copy .env.example .env
# ==============================================================================

# Application Environment: 'development' or 'production'
# In production, demo account seeding is strictly disabled.
AUTHGUARD_ENV=development

# Server Host & Port
HOST=127.0.0.1
PORT=5000

# Secret key for server-side session signing.
# In production, set this to a cryptographically secure random string (e.g. 64+ hex chars).
# If left empty in development, a secure ephemeral key is generated per process.
SECRET_KEY=dev-insecure-secret-key-change-in-production-32bytes

# Database file location (relative to backend/ or absolute path)
DATABASE_PATH=authguard.db

# Demo Mode & Account Provisioning
# Setting DEMO_MODE=true enables demo informational UI and allows seeding
# the demo user ONLY when AUTHGUARD_ENV is 'development'.
DEMO_MODE=true
SEED_DEMO_USER=true
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=DemoAdminPassword2026!

# Allowed CORS Origins (comma-separated).
# Wildcard '*' is NOT supported with authenticated sessions for security.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:3000,http://localhost:3000

# Geolocation Settings
# By default, external IP geolocation is disabled to prevent leaking IP addresses.
# Private/loopback IPs are automatically resolved locally.
ENABLE_EXTERNAL_GEOIP=false

# Rate Limiting Settings
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_SIMULATE=60 per minute
